// Передаем пины в конструктор (используем исправленный LORA_DIO0)
SX1278 radio = new Module(LORA_SS, LORA_DIO0, LORA_RST, RADIOLIB_NC);

void setup() {
  Serial.begin(115200);

  // Переводим частоту из Гц (433000000) в МГц (433.0) для RadioLib
  float freqMHz = LORA_FREQ / 1000000.0; 
  
  Serial.print(F("[LoRa] Initializing ... "));
  int state = radio.begin(freqMHz);

  if (state == RADIOLIB_ERR_NONE) {
    Serial.println(F("success!"));
    
    // Применяем ваши боевые настройки для зданий:
    radio.setSpreadingFactor(LORA_SF);
    radio.setBandwidth(LORA_BW / 1000.0;); // RadioLib принимает кГц (125.0)
    radio.setCodingRate(LORA_CR);
    radio.setOutputPower(LORA_TX_POWER);
    radio.setSyncWord(LORA_SYNC_WORD);
    
  } else {
    Serial.print(F("failed, code "));
    Serial.println(state);
    while (true);
  }
}

#define LORA_SS           5
#define LORA_RST          14
#define LORA_DIO0         26         // ⚠️ НАПОМИНАНИЕ: Перенесите с GPIO2 на GPIO26 для стабильного старта ESP32
#define LORA_FREQ         433E6      // Отлично для стен (433 МГц огибает препятствия лучше, чем 868)
#define LORA_SYNC_WORD    0xF3       // Хорошо (уникальный маркер вашей сети)

// СЮДА ВНОСИМ ИЗМЕНЕНИЯ:
#define LORA_SF           10         // Было 7. Увеличиваем до 10 для "пробивной" способности
#define LORA_BW           125E3      // Отлично (оптимальная ширина полосы)
#define LORA_CR           8          // Было 5. Ставим максимум (8) для максимальной защиты от помех
#define LORA_TX_POWER     20         // Отлично (максимальная мощность передатчика Ra-02)




С учетом I2S аудио и LoRa Ra-02 (на 433 МГц), ваша финальная таблица пинов должна выглядеть следующим образом:ПериферияПин модуляПин ESP32Статус / ПримечаниеLoRa (SX1278)NSS / CSGPIO5Аппаратный VSPI SSSCKGPIO18Аппаратный VSPI SCKMISOGPIO19Аппаратный VSPI MISOMOSIGPIO23Аппаратный VSPI MOSIRSTGPIO14Безопасный цифровой пинDIO0GPIO4🟢 Перенесен сюда (Безопасен для прерываний)Аудио (MAX98357A)BCLKGPIO26I2S Bit ClockLRCGPIO25I2S Word SelectDINGPIO33I2S Data InSDНе подключатьОставить в воздухе (для режима Моно)




Конфликты и их решениеКонфликт LRC и DIO0:Проблема: Ваш MAX98357A использует GPIO25 для линии LRC. Если мы перенесем LORA_DIO0 на GPIO25 или GPIO26 (как обсуждалось ранее), аудио-сигнал начнет подавать импульсы высокой частоты на вход прерывания LoRa, либо LoRa заблокирует аудиопоток.Решение: Для LoRa DIO0 используем свободный и безопасный GPIO4.Опасность вывода SD на MAX98357A:Проблема: Вы подключили вывод SD (Shutdown) усилителя напрямую к 3.3V. В MAX98357A пин SD не просто включает микросхему, он отвечает за выбор аудио-канала (левый, правый или моно-микс) в зависимости от напряжения или подтяжки. Жесткое подключение к 3.3V без резистора может перевести чип в нештатный режим или вызвать повышенный шум.Решение: Для моно-микширования (левый + правый каналы в один динамик) вывод SD нужно оставить вообще никуда не подключенным (в воздухе). Внутри чипа уже есть правильная подтяжка. Если хотите управлять включением/выключением усилителя (для экономии энергии в тишине), подключите его к любому свободному GPIO ESP32 (например, GPIO32) через резистор 100 кОм.


У вас на одной плате работают сразу два мощных потребителя: LoRa передатчик на 20 dBm (130 мА) и усилитель I2S (до 500 мА).Если вы будете питать схему просто от USB-порта компьютера, ESP32 уйдет в циклическую перезагрузку при первой же попытке отправить пакет, либо звук будет сильно искажаться.Обязательно используйте внешний качественный источник питания 5V (минимум 1.5–2 Ампера).Поставьте по электролитическому конденсатору на линии питания 3.3V (для LoRa) и 5V (для I2S усилителя).
